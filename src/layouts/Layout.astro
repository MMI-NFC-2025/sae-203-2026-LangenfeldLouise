---
// Layout.astro - Template de base pour toutes les pages
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
    title?: string;
    description?: string;
}

const {
    title = "Fanfa'Contoise",
    description = "Fanfa'Contoise - Festival de musique sur les scènes du centre-ville de Montbéliard",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <title>{title}</title>
    </head>
    <body class="bg-bleu-ciel text-white overflow-x-hidden">
        <Header />
        <main>
            <slot />
        </main>
        <Footer />
    </body>
</html>
