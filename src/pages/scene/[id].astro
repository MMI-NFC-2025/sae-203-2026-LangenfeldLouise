---
// src/pages/scene/[id].astro - Page détail d'une scène
import Layout from "../../layouts/Layout.astro";
import { AllSceneNom } from "../../../backend/backend.mjs";
const scene = await AllSceneNom();

export async function getStaticPaths() {
    return Object.keys(scene).map((id) => ({
        params: { id },
        props: { scene: scene[id] },
    }));
}

interface Props {
    scene: (typeof scene)[keyof typeof scene];
}

const { id } = Astro.params;
const scenes = Astro.props.scene;

if (!scenes) {
    return Astro.response.write("Scène non trouvée");
}
---

<Layout title={`${scenes.nom_scene} - Fanfa'Contoise`}>
    <!-- Section en-tête -->
    <section class="bg-primary-blue py-8 md:py-12 lg:py-16">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 md:px-8">
            <a
                href="/scene"
                class="inline-flex items-center gap-2 text-detail hover:text-white transition-colors mb-4 md:mb-6 text-sm md:text-base"
            >
                <img
                    src="/assets/icons/arrow/icon_flecheG.svg"
                    alt="retour"
                    class="w-4 h-4 md:w-5 md:h-5"
                />
                <span>Retour</span>
            </a>
            <h1
                class="font-title font-bold text-2xl sm:text-3xl md:text-4xl lg:text-5xl"
            >
                {scenes.nom_scene}
            </h1>
        </div>
    </section>

    <!-- Section description -->
    <section class="bg-primary-blue py-8 md:py-12 lg:py-16">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 md:px-8">
            <div
                class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 items-start"
            >
                <!-- Image -->
                <div class="flex justify-center">
                    <img
                        src={scenes.photo}
                        alt={scenes.nom_scene}
                        class="rounded-2xl max-w-sm md:max-w-md w-full h-auto object-cover shadow-xl"
                    />
                </div>

                <!-- Contenu -->
                <div class="space-y-4 md:space-y-6">
                    <div>
                        <h2
                            class="font-title font-bold text-lg md:text-xl lg:text-2xl text-white mb-2"
                        >
                            À propos
                        </h2>
                        <p
                            class="text-white text-sm md:text-base leading-relaxed"
                        >
                            {scenes.description}
                        </p>
                    </div>

                    <div>
                        <h3
                            class="font-title font-bold text-detail text-sm md:text-base lg:text-lg mb-2"
                        >
                            Capacité
                        </h3>
                        <p class="text-white text-sm md:text-base">
                            {scenes.capacite}
                        </p>
                    </div>

                    <a
                        href="#"
                        class="cta inline-flex items-center gap-2 text-sm md:text-base lg:text-lg"
                    >
                        <span>Découvrir les artistes</span>
                        <img
                            src="/assets/icons/arrow/icon_cta_billet.svg"
                            alt=""
                            class="w-4 h-4 md:w-5 md:h-5"
                        />
                    </a>
                </div>
            </div>
        </div>
    </section>
</Layout>
