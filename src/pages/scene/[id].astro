---
import Layout from "../../layouts/Layout.astro";
import {
    ArtisteIdScene,
    InfoScene,
    getImageUrl,
    formatSceneDate,
} from "../../../backend/backend.mjs";

const id = Astro.params.id ?? "";
const scene = await InfoScene(id);

if (!scene) {
    return Astro.redirect("/404");
}

const artists = await ArtisteIdScene(id);
const sceneImage = getImageUrl(scene, "photo");

const sceneName = scene.nom_scene ?? "Scène";
const sceneDescription = scene.description ?? "Description indisponible.";

const lineupArtists = artists.map((artist) => ({
    id: artist.id,
    name: artist.nom_artiste ?? "Artiste",
    date: formatSceneDate(artist.date_representation),
}));
---

<Layout title={`${sceneName}`} description="Détail scène">
    <main class="scene-page-wrap">
        <section class="section section--wrapper scene-page">
            <button
                class="scene-pageback-btn"
                type="button"
                onclick="window.history.back()"
            >
                <span aria-hidden="true">←</span>
                <span class="u-sr-only">Retour aux scènes</span>
            </button>

            <header class="scene-pageheader">
                <h1
                    class="scene-pagetitle font-title font-bold text-2xl sm:text-3xl md:text-4xl lg:text-5xl text-center mb-3 md:mb-4"
                >
                    {sceneName}
                </h1>
            </header>

            {
                sceneImage ? (
                    <img
                        class="w-full mx-0 lg:w-[calc(100%-550px)] lg:mx-auto lg:rounded-2xl"
                        src={sceneImage}
                        alt={`Photo de ${sceneName}`}
                        loading="lazy"
                    />
                ) : (
                    <div class="scene-pageimg">Aucune image disponible</div>
                )
            }

            <div class="grid grid-cols-9 scene-pagepanels">
                <p class="scene-pagetext col-start-2 col-end-9">
                    {sceneDescription}
                </p>

                <h2
                    class="scene-pagetitle font-title font-bold text-2xl sm:text-3xl md:text-4xl lg:text-5xl text-center mb-3 md:mb-4 col-start-4 col-end-7"
                >
                    Artistes programmés :
                </h2>

                <section class="scene-pagelineup col-start-4 col-end-7 lg:col-start-5 lg:col-end-5">
                    <ul class="scene-artists u-list-unstyled">
                        {
                            lineupArtists.length === 0 ? (
                                <li class="scene-artistsitem">
                                    Aucun artiste programmé.
                                </li>
                            ) : (
                                lineupArtists.map((artist) => (
                                    <li class="scene-artistsitem">
                                        <a
                                            class="scene-pageartist-link"
                                            href={`/artistes/${artist.id}`}
                                        >
                                            {artist.name} — {artist.date}
                                        </a>
                                    </li>
                                ))
                            )
                        }
                    </ul>
                </section>
            </div>

            <div class="grid grid-cols-9 scene-pageactions">
                <a
                    class="btn scene-pagecta col-start-4 col-end-7 text-center"
                    href="/artistes"
                >
                    Voir tous les Artistes
                </a>
            </div>
        </section>
    </main>
</Layout>
