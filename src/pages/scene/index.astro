---
import Layout from "../../layouts/Layout.astro";
import { AllSceneNom, getImageUrl } from "../../../backend/backend.mjs";

const scenes = await AllSceneNom();
---

<Layout title="Les Scènes - Fanfa'Contoise">
    <!-- Section héro -->
    <section class="bg-primary-blue py-8 md:py-12 lg:py-16">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 md:px-8">
            <h1
                class="font-title font-bold text-2xl sm:text-3xl md:text-4xl lg:text-5xl text-center mb-3 md:mb-4"
            >
                Les Scènes
            </h1>
            <p
                class="text-center text-sm sm:text-base md:text-lg text-detail font-special"
            >
                Découvrez les différents espaces de performance du festival.
            </p>
        </div>
    </section>

    <!-- Section liste des scènes -->
    <section class="bg-primary-blue py-8 md:py-12 lg:py-16">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 md:px-8">
            <h2
                class="font-title font-bold text-xl sm:text-2xl md:text-3xl lg:text-4xl text-center mb-8 md:mb-12 text-detail"
            >
                Nos 3 scènes
            </h2>

            <!-- Grille de scènes -->
            <div
                class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5 md:gap-6"
            >
                {
                    scenes.map((scene) => {
                        const imageUrl = getImageUrl(scene, "photo");

                        return (
                            <a
                                href={`/scene/${scene.id}`}
                                class="group relative overflow-hidden rounded-2xl flex flex-col items-center justify-end h-56 sm:h-64 md:h-72 hover:shadow-2xl transition-all duration-300"
                            >
                                {imageUrl ? (
                                    <img
                                        src={imageUrl}
                                        alt={scene.nom_scene}
                                        class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
                                    />
                                ) : (
                                    <div class="absolute inset-0 w-full h-full bg-gray-700 flex items-center justify-center text-white">
                                        Aucune image
                                    </div>
                                )}

                                <div class="absolute inset-0 bg-linear-to-t from-black via-transparent to-transparent opacity-60 group-hover:opacity-100 transition-opacity duration-300" />

                                <div class="relative z-10 text-center pb-4 sm:pb-5 md:pb-6 px-4">
                                    <h3 class="font-title text-lg sm:text-xl md:text-2xl font-bold text-white mb-1">
                                        {scene.nom_scene}
                                    </h3>
                                </div>
                            </a>
                        );
                    })
                }
            </div>
        </div>
    </section>
</Layout>
