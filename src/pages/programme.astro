---
// src/pages/programme/index.astro - Page du programme
import Layout from "../layouts/Layout.astro";

const schedule = [
    {
        day: "Vendredi 26 Juin 2026",
        events: [
            { time: "18:00", artist: "Abigoba", scene: "Saint-Martin" },
            { time: "19:30", artist: "Boulou", scene: "Saint-Martin" },
            {
                time: "21:00",
                artist: "Fanfare 5 Fantastique",
                scene: "Saint-Martin",
            },
        ],
    },
    {
        day: "Samedi 27 Juin 2026",
        events: [
            {
                time: "18:00",
                artist: "Batterie Fanfare",
                scene: "Denfert-Rochereau",
            },
            { time: "19:30", artist: "Cédille", scene: "Denfert-Rochereau" },
            {
                time: "21:00",
                artist: "Ibrahim Maalouf",
                scene: "Denfert-Rochereau",
            },
        ],
    },
    {
        day: "Dimanche 28 Juin 2026",
        events: [
            { time: "18:00", artist: "Borruto", scene: "Albert-Thomas" },
            { time: "19:30", artist: "Emile Parisien", scene: "Albert-Thomas" },
            { time: "21:00", artist: "Buck", scene: "Albert-Thomas" },
        ],
    },
];
---

<Layout title="Le Programme - Fanfa'Contoise">
    <!-- Section héro -->
    <section class="bg-primary-blue py-8 md:py-12 lg:py-16">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 md:px-8">
            <h1
                class="font-title font-bold text-2xl sm:text-3xl md:text-4xl lg:text-5xl text-center mb-3 md:mb-4"
            >
                Le Programme
            </h1>
            <p
                class="text-center text-sm sm:text-base md:text-lg text-detail font-special"
            >
                Découvrez l'ordre de passage des artistes et planifiez votre
                festival.
            </p>
        </div>
    </section>

    <!-- Section programme -->
    <section class="bg-primary-blue py-8 md:py-12 lg:py-16">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 md:px-8">
            <h2
                class="font-title font-bold text-xl sm:text-2xl md:text-3xl lg:text-4xl text-center mb-8 md:mb-12 text-detail"
            >
                Ordre de passage
            </h2>

            <!-- Horaires par jour -->
            <div class="space-y-6 md:space-y-8">
                {
                    schedule.map((daySchedule) => (
                        <div class="border-l-4 border-detail pl-4 md:pl-6">
                            <h3 class="font-title font-bold text-lg sm:text-xl md:text-2xl text-bleu-ciel mb-4 md:mb-6">
                                {daySchedule.day}
                            </h3>

                            <div class="space-y-3 md:space-y-4">
                                {daySchedule.events.map((event) => (
                                    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2 sm:gap-4 bg-white bg-opacity-5 p-3 md:p-4 rounded-lg hover:bg-opacity-10 transition-colors">
                                        <div>
                                            <p class="font-title font-bold text-bleu-ciel text-sm md:text-base lg:text-lg">
                                                {event.artist}
                                            </p>
                                            <p class="text-bleu-ciel text-xs md:text-sm">
                                                Scène {event.scene}
                                            </p>
                                        </div>
                                        <div class="text-right sm:text-right">
                                            <p class="font-title font-bold text-bleu-ciel text-lg md:text-xl">
                                                {event.time}
                                            </p>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    ))
                }
            </div>

            <!-- CTA billetterie -->
            <div class="flex justify-center mt-12">
                <a
                    href="#"
                    class="cta cta__ticket inline-flex items-center gap-2 text-lg"
                >
                    <span>Accéder à la billetterie</span>
                    <img
                        src="/assets/icons/arrow/arrow-cta.svg"
                        alt=""
                        class="w-5 h-5"
                    />
                </a>
            </div>
        </div>
    </section>
</Layout>
