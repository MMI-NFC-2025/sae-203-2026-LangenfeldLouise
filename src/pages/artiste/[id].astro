---
import Layout from "../../layouts/Layout.astro";
import {
    getArtisteById,
    InfoScene,
    AllArtiste,
    getImageUrl,
    formatSceneDate,
    pb,
} from "../../../backend/backend.mjs";

export async function getStaticPaths() {
    const artistes = await AllArtiste();

    return artistes.map((artiste) => ({
        params: { id: artiste.id },
    }));
}

const id = Astro.params.id ?? "";
const artiste = await getArtisteById(id);

if (!artiste) {
    return Astro.redirect("/404");
}

const scene = artiste.scenes?.length
    ? await InfoScene(artiste.scenes[0])
    : null;

const artisteName = artiste.nom_artiste ?? "Artiste";
const sceneName = scene?.nom_scene ?? "Scène inconnue";
const concertDate = formatSceneDate(artiste.date_representation);

const heroImage = getImageUrl(artiste, "photo_principale");
const galerie = artiste.galerie_photo ?? [];

const bioText =
    artiste.description ||
    artiste.biographie ||
    `${artisteName} ${
        artiste.genre_musical ? `de ${artiste.genre_musical.toLowerCase()}` : ""
    } pendant le festival.`;

const metaItems = [
    { label: "Passage", value: concertDate, valueClass: "artist-page__date" },
    { label: "Scène", value: sceneName, valueClass: "artist-page__scene" },
    ...(artiste.genre_musical
        ? [{ label: "Style", value: artiste.genre_musical, valueClass: "" }]
        : []),
];
---

<Layout title={`${artisteName}`} description="Détail artiste">
    <main class="artist-page">
        <section class="artist-page__hero">
            <button
                class="artist-page__back-btn"
                type="button"
                onclick="window.history.back()"
            >
                <span aria-hidden="true">←</span>
                <span class="u-sr-only">Retour aux artistes</span>
            </button>
            <header class="scene-pageheader">
                <h1
                    class="scene-pagetitle font-title font-bold text-2xl sm:text-3xl md:text-4xl lg:text-5xl text-center mb-3 md:mb-4"
                >
                    {artisteName}
                </h1>
            </header>

            {
                heroImage ? (
                    <img
                        class="w-full mx-0 lg:w-[calc(100%-550px)] lg:mx-auto lg:rounded-2xl"
                        src={heroImage}
                        alt={artisteName}
                        loading="lazy"
                    />
                ) : (
                    <div class="artist-page__hero-img">
                        Aucune image disponible
                    </div>
                )
            }
        </section>

        <section class="grid grid-cols-9 section section--wrapper artist-page__info">
            <p class="col-start-4 col-end-8 artist-page__meta artist-page__meta--mobile lg:col-start-5">
                <span class="artist-page__date">{concertDate}</span><br />
                <span class="artist-page__scene">{sceneName}</span>
            </p>

            <div class="col-start-2 col-span-3 lg:col-start-3 artist-page__meta-grid">
                {
                    metaItems.map((item) => (
                        <article class="artist-page__meta-card">
                            <p class="artist-page__meta-label">{item.label}</p>
                            <p
                                class={`artist-page__meta-value ${item.valueClass}`}
                            >
                                {item.value}
                            </p>
                        </article>
                    ))
                }
            </div>

            <p class="artist-page__bio col-start-6 col-span-3">{bioText}</p>
        </section>

        <section class="section section--wrapper artist-page__gallery text-center">
            <h2 class="col-start-5 artist-page__gallery-title">Galerie</h2>

            {
                galerie.length > 0 ? (
                    <div class="mx-auto max-w-full px-4 pt-1">
                        <div class="overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
                            <div class="flex snap-x snap-mandatory gap-4">
                                {galerie.map((fileName, index) => (
                                    <img
                                        src={pb.files.getURL(artiste, fileName)}
                                        alt={`${artisteName} - photo ${index + 1}`}
                                        class="rounded-3xl h-60 w-200 min-w-80 snap-center object-cover"
                                        loading="lazy"
                                    />
                                ))}
                            </div>
                        </div>
                    </div>
                ) : (
                    <p class="text-gray-600">
                        Aucune photo de galerie disponible.
                    </p>
                )
            }
        </section>

        <section class="grid grid-cols-9 section section--wrapper artist-page__cta">
            <a class="col-start-4 col-span-4 lg:col-start-5 btn artist-page__program-btn" href="/programme">
                Voir le programme complet
            </a>
        </section>
    </main>
</Layout>
