---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Nous contacter - Fanfa'Contoise">
    <section class="bg-primary-blue py-8 md:py-12 lg:py-16">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 md:px-8">
            <h1
                class="font-title font-bold text-2xl sm:text-3xl md:text-4xl lg:text-5xl text-center mb-3 md:mb-4"
            >
                Nous contacter
            </h1>
            <p
                class="text-center text-sm sm:text-base md:text-lg text-detail font-special"
            >
                Pour communiquer avec nous, remplissez le formulaire ci-dessous
            </p>
        </div>
    </section>

    <section class="bg-primary-blue py-8 md:py-12 lg:py-16">
        <div class="max-w-2xl mx-auto px-4 sm:px-6 md:px-8">
            <h2
                class="font-title font-bold text-xl sm:text-2xl md:text-3xl lg:text-4xl text-center mb-8 md:mb-12 text-detail"
            >
                Formulaire de contact
            </h2>

            <form class="space-y-4 md:space-y-6" method="POST">
                <div>
                    <label
                        for="firstname"
                        class="block font-title font-bold text-bleu-vert mb-2 text-sm md:text-base"
                    >
                        Prénom
                    </label>
                    <input
                        type="text"
                        id="firstname"
                        name="firstname"
                        class="w-full bg-white text-bleu-vert rounded-lg px-3 md:px-4 py-2.5 md:py-3 text-sm md:text-base focus:outline-none focus:ring-2 focus:ring-detail placeholder-primary-blue placeholder-opacity-50"
                        placeholder="Votre prénom"
                        required
                    />
                </div>

                <div>
                    <label
                        for="lastname"
                        class="block font-title font-bold text-bleu-vert mb-2 text-sm md:text-base"
                    >
                        Nom
                    </label>
                    <input
                        type="text"
                        id="lastname"
                        name="lastname"
                        class="w-full bg-white text-bleu-vert rounded-lg px-3 md:px-4 py-2.5 md:py-3 text-sm md:text-base focus:outline-none focus:ring-2 focus:ring-detail placeholder-primary-blue placeholder-opacity-50"
                        placeholder="Votre nom"
                        required
                    />
                </div>

                <div>
                    <label
                        for="email"
                        class="block font-title font-bold text-bleu-vert mb-2 text-sm md:text-base"
                    >
                        E-mail
                    </label>
                    <input
                        type="email"
                        id="email"
                        name="email"
                        class="w-full bg-white text-bleu-vert rounded-lg px-3 md:px-4 py-2.5 md:py-3 text-sm md:text-base focus:outline-none focus:ring-2 focus:ring-detail placeholder-primary-blue placeholder-opacity-50"
                        placeholder="votre@email.com"
                        required
                    />
                </div>

                <div>
                    <label
                        for="message"
                        class="block font-title font-bold text-bleu-vert mb-2 text-sm md:text-base"
                    >
                        Message
                    </label>
                    <textarea
                        id="message"
                        name="message"
                        rows="6"
                        class="w-full bg-white text-bleu-vert rounded-lg px-3 md:px-4 py-2.5 md:py-3 text-sm md:text-base focus:outline-none focus:ring-2 focus:ring-detail placeholder-primary-blue placeholder-opacity-50 resize-none"
                        placeholder="Votre message ici..."
                        required></textarea>
                </div>

                <div class="flex justify-center pt-4">
                    <button
                        type="submit"
                        class="cta inline-flex items-center gap-2 text-sm sm:text-base md:text-lg"
                    >
                        <span>Envoyer</span>
                        <img
                            src="/assets/icons/arrow/icon_cta_billet.svg"
                            alt=""
                            class="w-4 h-4 md:w-5 md:h-5"
                        />
                    </button>
                </div>
            </form>

            <div class="mt-8 md:mt-12 pt-6 md:pt-8 border-t border-detail">
                <p class="text-center text-white text-sm md:text-base">
                    Vous avez une question ? Consultez notre <a
                        href="/faq"
                        class="text-detail hover:underline font-bold">FAQ</a
                    > qui pourrait contenir la réponse.
                </p>
            </div>
        </div>
    </section>
</Layout>
