---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page non trouvée - Fanfa'Contoise">
    <section
        class="bg-primary-blue min-h-[70vh] flex items-center justify-center py-8 md:py-12 lg:py-16"
    >
        <div class="max-w-2xl mx-auto px-4 sm:px-6 md:px-8 text-center">
            <h1
                class="font-title font-bold text-6xl sm:text-7xl md:text-8xl lg:text-9xl text-detail mb-4 md:mb-6"
            >
                404
            </h1>

            <h2
                class="font-title font-bold text-xl sm:text-2xl md:text-3xl lg:text-4xl text-white mb-3 md:mb-4"
            >
                Oups ! Page non trouvée
            </h2>

            <p
                class="text-sm md:text-base lg:text-lg text-white mb-6 md:mb-8 leading-relaxed"
            >
                Désolé, la page que vous recherchez n'existe pas ou a été
                déplacée. Revenez à la page d'accueil pour continuer votre
                visite du festival Fanfa'Contoise.
            </p>

            <div
                class="flex flex-col sm:flex-row gap-3 md:gap-4 justify-center"
            >
                <a
                    href="/"
                    class="cta inline-flex items-center justify-center gap-2 text-sm sm:text-base md:text-lg"
                >
                    <span>Retourner à l'accueil</span>
                    <img
                        src="/assets/icons/arrow/icon_cta_billet.svg"
                        alt=""
                        class="w-4 h-4 md:w-5 md:h-5"
                    />
                </a>

                <a
                    href="/programme"
                    class="inline-flex items-center justify-center gap-2 text-sm sm:text-base md:text-lg font-title font-bold text-detail hover:text-white transition-colors border-2 border-detail rounded-full px-4 md:px-6 py-2.5 md:py-3"
                >
                    <span>Voir le programme</span>
                    <img
                        src="/assets/icons/arrow/icon_cta_billet.svg"
                        alt=""
                        class="w-4 h-4 md:w-5 md:h-5"
                    />
                </a>
            </div>

            <div class="mt-8 md:mt-12 pt-6 md:pt-8 border-t border-detail">
                <p class="text-white text-xs md:text-sm mb-4 md:mb-6">
                    Ou explorez nos pages principales :
                </p>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 md:gap-4">
                    <a
                        href="/about"
                        class="text-detail hover:text-white transition-colors font-body text-xs md:text-sm"
                    >
                        Notre Festival
                    </a>
                    <a
                        href="/artiste"
                        class="text-detail hover:text-white transition-colors font-body text-xs md:text-sm"
                    >
                        Les Artistes
                    </a>
                    <a
                        href="/scene"
                        class="text-detail hover:text-white transition-colors font-body text-xs md:text-sm"
                    >
                        Les Scènes
                    </a>
                    <a
                        href="/faq"
                        class="text-detail hover:text-white transition-colors font-body text-xs md:text-sm"
                    >
                        FAQ
                    </a>
                </div>
            </div>
        </div>
    </section>
</Layout>
