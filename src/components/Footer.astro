---
import "../styles/global.css";
---

<footer class="mt-12 md:mt-16 py-8 md:py-12">
    <!-- Section Newsletter -->
    <div class="px-4 sm:px-6 md:px-8 pb-6 md:pb-8 border-b-2 border-detail">
        <div
            class="flex flex-col sm:flex-row items-start sm:items-center gap-3 mb-4"
        >
            <span class="font-title text-sm sm:text-base font-bold">
                Inscrivez-vous à notre newsletter ici !
            </span>
        </div>

        <!-- Formulaire newsletter -->
        <form class="flex flex-col sm:flex-row gap-2">
            <input
                type="email"
                placeholder="Entrez votre adresse e-mail..."
                class="flex-1 bg-blue-300 text-primary-blue rounded-full px-4 py-2.5 text-sm placeholder-primary-blue focus:outline-none focus:ring-2 focus:ring-detail"
                required
            />
            <button
                type="submit"
                class="bg-detail hover:bg-opacity-90 text-primary-blue rounded-full p-2.5 transition-all flex items-center justify-center shrink-0"
                aria-label="Soumettre"
            >
                <img
                    src="/assets/icons/arrow/icon_flecheD.svg"
                    alt=""
                    class="w-5 h-5"
                />
            </button>
        </form>
    </div>

    <!-- Section infos et partenaires -->
    <div
        class="bg-blue-300 px-4 sm:px-6 md:px-8 pt-6 md:pt-8 grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 md:gap-8 items-start"
    >
        <!-- Liens -->
        <div class="flex flex-col gap-3 sm:col-span-1">
            <a
                href="/contact"
                class="hover:text-detail transition-colors text-xs sm:text-sm font-body"
            >
                Contact
            </a>
            <a
                href="#"
                class="hover:text-detail transition-colors text-xs sm:text-sm font-body"
            >
                Mentions Légales
            </a>
        </div>

        <!-- Logos partenaires -->
        <div class="flex gap-3 col-span-1 justify-start sm:justify-center">
            <img
                src="/assets/img/partners/img_pma-vide.avif"
                alt="PMA"
                class="h-6 sm:h-7 md:h-8 w-auto"
            />
            <img
                src="/assets/img/partners/img_montbeliard-ville_vide.avif"
                alt="Montbéliard"
                class="h-6 sm:h-7 md:h-8 w-auto"
            />
        </div>

        <!-- Copyright -->
        <div class="col-span-1 sm:col-span-2 md:col-span-3">
            <p class="text-xs text-center sm:text-left font-body">
                Fanfa'Comtoise © 2025 ~ Réalisation Sacha MARTIN
            </p>
        </div>
    </div>
</footer>
