---
interface Props {
    image: string;
    name: string;
    date: string;
    href?: string;
}

const { image, name, date, href = "#" } = Astro.props;
---

<a
    href={href}
    class="group relative overflow-hidden rounded-2xl flex flex-col items-center justify-end h-56 sm:h-64 md:h-72 hover:shadow-2xl transition-all duration-300">
    <img
        src={image}
        alt={name}
        class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-300"
    />

    <div
        class="absolute inset-0 bg-linear-to-t from-black via-transparent to-transparent opacity-60 group-hover:opacity-100 transition-opacity duration-300"
    >
    </div>

    <div class="relative z-10 text-center pb-4 sm:pb-5 md:pb-6 px-4">
        <h3
            class="font-title text-lg sm:text-xl md:text-2xl font-bold text-white mb-1"
        >
            {name}
        </h3>
        <p class="font-body text-xs sm:text-sm md:text-base text-detail">
            {date}
        </p>
    </div>
</a>

<p class="font-body text-xs sm:text-sm md:text-base text-detail">
    {date}
</p>
